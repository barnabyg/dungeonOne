        "topics": [
          {
            "replies": [
              {
                "approvedFactIds": [
                  "mira-saw-smoke"
                ],
                "text": "Mira: At dawn I saw blue smoke curl from the mill loft, then heard someone strike the signal bell twice.",
                "approach": "any",
                "outcome": "success",
                "attitude": "relieved",
                "effects": [],
                "when": []
              },
              {
                "approvedFactIds": [],
                "text": "Mira: I cannot spare more certainty. Search the mill yourself if you mean to help.",
                "approach": "any",
                "outcome": "failure",
                "attitude": "worried",
                "effects": [],
                "when": []
              },
              {
                "approvedFactIds": [],
                "text": "Mira: Give me a reason to trust that you will not abandon him in there.",
                "approach": "ask",
                "outcome": "unattempted",
                "attitude": "guarded",
                "effects": [],
                "when": []
              },
              {
                "approvedFactIds": [],
                "text": "Mira: Tovin took the old courier road through the watermill.",
                "approach": "any",
                "outcome": "any",
                "attitude": "worried",
                "effects": [],
                "when": []
