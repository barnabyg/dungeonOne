{
  "schemaVersion": 3,
  "id": "lantern-archive",
  "contentVersion": "1",
  "rulesVersion": "chapel-clues-rules-v4",
  "title": "The Lantern Archive",
  "introduction": "A signal from the old archive has gone dark. Begin in the square.",
