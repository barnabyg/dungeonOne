  "id": "wandering-tunnels",
  "title": "The Wandering Tunnels",
  "objective": "Find out what has moved into the old smugglers' cellar, and clear it out.",
  "recommendedLevels": {
    "min": 1,
    "max": 1
  },
  "difficulty": "hard",
  "startRoomId": "stair-foot",
  "rooms": [
    {
      "id": "stair-foot",
      "name": "Foot of the Stair",
      "description": "Worn steps end in a cold cellar passage. Water drips somewhere ahead, and the air smells of rot and lamp oil.",
      "features": [
        {
          "id": "rusted-lantern",
          "name": "Rusted Lantern",
          "description": "A rusted lantern hangs from a hook by the stair, its glass cracked.",
          "discovery": "Scratched into the lantern's base: \"Rats in the cellar. Boss in the den.\""
        }
      ],
      "items": [],
      "region": "upper"
    },
    {
      "id": "alcove",
      "name": "Alcove",
      "description": "A cramped alcove cut into the rock, out of the draught. Someone slept here once.",
      "features": [
        {
          "id": "iron-chest",
          "name": "Iron-Bound Chest",
          "description": "A squat iron-bound chest sits in the corner, its lock long since broken.",
          "discovery": "Under a mouldy blanket in the chest lies a stoppered vial of red liquid."
        }
      ],
      "items": [
        {
          "id": "healing-potion",
          "name": "Potion of Healing",
          "description": "A stoppered vial of red liquid that glimmers when shaken.",
          "kind": "potion-of-healing",
          "hiddenIn": "iron-chest"
        }
      ],
      "region": "upper",
      "restSite": true
    },
    {
      "id": "rat-cellar",
      "name": "Rat-Gnawed Cellar",
      "description": "Grain sacks slump against the walls, chewed open. Droppings cover the floor.",
      "encounterId": "cellar-rat",
      "features": [
        {
          "id": "gnawed-sacks",
          "name": "Gnawed Sacks",
          "description": "The sacks held grain once. Now they hold mostly droppings."
        }
      ],
      "items": [],
      "region": "lower"
    },
    {
      "id": "den",
      "name": "Smugglers' Den",
      "description": "A vaulted room with a cold hearth, a table of empty bottles and a barrel used as a desk.",
      "encounterId": "den-goblin",
      "features": [
        {
          "id": "ledger",
          "name": "Damp Ledger",
          "description": "A damp ledger lies open on the barrel.",
          "discovery": "The last entry reads: \"Goods moved upriver. The goblin stays to guard the den.\""
        }
      ],
      "items": [],
      "region": "lower"
    },
    {
      "id": "landing",
      "name": "Landing",
      "description": "A wide step in the tunnel, worn smooth by many feet.",
      "region": "lower",
      "features": [],
      "items": []
    }
  ],
